<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Battery and background operation"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/textBatteryStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Checking battery optimisation status…"
        android:textSize="14sp"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/buttonBatteryExemption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Request unrestricted battery use" />

    <Button
        android:id="@+id/buttonBatterySettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open app battery settings" />

</LinearLayout>